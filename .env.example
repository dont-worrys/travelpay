# 로컬 개발용 예시입니다. 실제 값은 개인 .env에서 관리합니다.
# Compose는 .env를 읽지만, Spring Boot에는 실행 환경 변수로 전달해야 합니다.
POSTGRES_IMAGE=postgres:18.6-bookworm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travelpay
POSTGRES_USER=travelpay_admin
POSTGRES_PASSWORD=local-admin-change-me

# 로컬 Redis입니다. 세션과 캐시를 별도 인스턴스와 포트로 구분합니다.
REDIS_IMAGE=redis:8.2.11-bookworm
REDIS_SESSION_HOST=localhost
REDIS_SESSION_PORT=16379
REDIS_SESSION_PASSWORD=local-session-change-me
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=16380
REDIS_CACHE_PASSWORD=local-cache-change-me
# 배포에서는 각 Redis의 컨테이너 주소와 내부 포트 6379를 사용합니다.

USER_DB_USERNAME=user_app
USER_DB_PASSWORD=local-user-change-me
USER_DB_URL="jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?currentSchema=user_service"

WALLET_DB_USERNAME=wallet_app
WALLET_DB_PASSWORD=local-wallet-change-me
WALLET_DB_URL="jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?currentSchema=wallet_service"
# 계좌번호 암호화 키 (Base64 32바이트). 각자 생성: openssl rand -base64 32
WALLET_ACCOUNT_NUMBER_KEY=

PAYMENT_DB_USERNAME=payment_app
PAYMENT_DB_PASSWORD=local-payment-change-me
PAYMENT_DB_URL="jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?currentSchema=payment_service"

EXCHANGE_DB_USERNAME=exchange_app
EXCHANGE_DB_PASSWORD=local-exchange-change-me
EXCHANGE_DB_URL="jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?currentSchema=exchange_service"
# 한국수출입은행 환율 API 인증키입니다. 실제 키는 개인 .env에만 둡니다.
KOREAEXIM_API_KEY=

LEDGER_DB_USERNAME=ledger_app
LEDGER_DB_PASSWORD=local-ledger-change-me
LEDGER_DB_URL="jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?currentSchema=ledger_service"

MOCK_BANK_DB_USERNAME=mock_bank_app
MOCK_BANK_DB_PASSWORD=local-bank-change-me
MOCK_BANK_DB_URL="jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?currentSchema=mock_bank"

# 배포 설정 선택은 실행 시 별도로 전달합니다. 로컬 기본값으로 활성화하지 않습니다.
# SPRING_CONFIG_NAME=application-prod
# SPRING_PROFILES_ACTIVE=prod
