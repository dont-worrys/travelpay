# 설명용 계정 ID입니다. 실제로는 bootstrap의 production_backend_config 출력을 사용합니다.
bucket              = "travelpay-tfstate-123456789012-ap-northeast-2"
key                 = "production/terraform.tfstate"
region              = "ap-northeast-2"
encrypt             = true
use_lockfile        = true
allowed_account_ids = ["123456789012"]
