name: travelpay-production-data

services:
  redis-session:
    image: ${redis_image}
    restart: unless-stopped
    mem_limit: 256m
    command: [redis-server, /run/redis.conf]
    ports: ["$${DATA_PRIVATE_IP:?}:16379:6379"]
    volumes:
      - type: bind
        source: /run/travelpay/redis/session.conf
        target: /run/redis.conf
        read_only: true
        bind: {create_host_path: false}
    healthcheck:
      test: [CMD-SHELL, 'REDISCLI_AUTH=$$(sed -n "s/^requirepass //p" /run/redis.conf) redis-cli --no-auth-warning ping | grep -qx PONG']
      interval: 10s
      timeout: 3s
      retries: 5
    logging: &bounded-logs
      driver: json-file
      options: {max-size: 10m, max-file: '3'}

  redis-cache:
    image: ${redis_image}
    restart: unless-stopped
    mem_limit: 256m
    command: [redis-server, /run/redis.conf]
    ports: ["$${DATA_PRIVATE_IP:?}:16380:6379"]
    volumes:
      - type: bind
        source: /run/travelpay/redis/cache.conf
        target: /run/redis.conf
        read_only: true
        bind: {create_host_path: false}
    healthcheck:
      test: [CMD-SHELL, 'REDISCLI_AUTH=$$(sed -n "s/^requirepass //p" /run/redis.conf) redis-cli --no-auth-warning ping | grep -qx PONG']
      interval: 10s
      timeout: 3s
      retries: 5
    logging: *bounded-logs

  kafka:
    image: ${kafka_image}
    restart: unless-stopped
    mem_limit: 3072m
    ports: ["$${DATA_PRIVATE_IP:?}:9092:9092"]
    environment:
      CLUSTER_ID: "$${KAFKA_CLUSTER_ID:?}"
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: EXTERNAL://:9092,INTERNAL://:29092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: EXTERNAL://data.travelpay.internal:9092,INTERNAL://kafka:29092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: EXTERNAL:PLAINTEXT,INTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093
      KAFKA_INTER_BROKER_LISTENER_NAME: INTERNAL
      KAFKA_LOG_DIRS: /var/lib/kafka/data
      KAFKA_LOG_RETENTION_HOURS: 168
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_SHARE_COORDINATOR_STATE_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR: 1
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: 'false'
      KAFKA_HEAP_OPTS: -Xms1G -Xmx1G
    volumes:
      - type: bind
        source: /srv/travelpay/kafka/data
        target: /var/lib/kafka/data
        bind: {create_host_path: false}
    healthcheck:
      test: [CMD, /opt/kafka/bin/kafka-broker-api-versions.sh, --bootstrap-server, localhost:29092]
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 60s
    logging: *bounded-logs
