    {
      "id": 11,
      "title": "HikariCP 연결 수 (사용/최대)",
      "description": "HikariCP 풀의 사용 중 연결 수와 최대 연결 수입니다. 풀 개수를 뜻하지 않습니다. 풀별 사용·최대 선을 비교하고 대기 스레드·획득 시간을 함께 확인합니다. 메트릭 환경·서비스 필터를 적용합니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 30,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\"}",
          "legendFormat": "{{service}} / {{pool}} 사용"
        },
        {
          "refId": "B",
