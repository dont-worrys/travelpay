    {
      "id": 108,
      "type": "row",
      "title": "환율 캐시 (Exchange)",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 20,
          "title": "환율 캐시 조회 결과",
          "description": "Exchange 전용 지표입니다. Service에 exchange-service가 포함되거나 All일 때 조회됩니다. 다른 서비스만 선택하면 데이터가 없습니다. 통화 키별 초당 조회수이며 hit=유효 캐시 반환, miss=없거나 해석할 수 없는 값, error=Redis 읽기 실패입니다. User의 Redis Session이나 견적 저장 성공 횟수와 다릅니다. 계측·수집이 없는 빈 값은 0이 아닙니다. API·HTTP 상태 필터는 적용하지 않습니다.",
          "type": "timeseries",
          "gridPos": {
            "x": 0,
            "y": 45,
            "w": 24,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-local"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (environment, service, result) (rate(exchange_rate_cache_lookups_total{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=\"exchange-service\",service=~\"${service:regex}\"}[$__rate_interval]))",
              "legendFormat": "{{service}} / {{result}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "min": 0
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byRegexp",
                  "options": ".* / hit$"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "green"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byRegexp",
                  "options": ".* / miss$"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "yellow"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byRegexp",
                  "options": ".* / error$"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "red"
                    }
                  }
                ]
              }
            ]
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true,
              "calcs": [
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        }
      ]
    },
    {
      "id": 105,
      "type": "row",
      "title": "서비스 연동 (Gateway)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "title": "User 세션 호출 시간",
      "description": "검증은 User 서비스가 Redis 세션과 회원 DB를 확인해 수행합니다. 이 패널은 Gateway의 WebClient가 기록한 세션 확인 API(I01)의 평균 HTTP 호출 시간입니다. 네트워크·User 응답 대기를 포함하며 User 내부 검증 시간이나 Redis 명령 시간만을 측정한 값은 아닙니다. Service에 gateway를 포함해야 표시됩니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (environment, service) (rate(http_client_requests_seconds_sum{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\",service=\"gateway\",client_name=\"user-service\"}[$__rate_interval])) / (sum by (environment, service) (rate(http_client_requests_seconds_count{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\",service=\"gateway\",client_name=\"user-service\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{service}} → User I01"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "title": "라우트 평균 처리 시간",
      "description": "Gateway가 기록한 라우트별 평균 처리 시간입니다. 목적 서비스 호출과 라우트 필터 처리를 포함하며 User뿐 아니라 Wallet·Payment 등 등록된 업무 서비스 라우트도 대상입니다. routeId·HTTP 메서드·응답 코드로 구분합니다. 인증에서 거절된 요청은 없을 수 있고 세션 API 호출 시간과 단순 차감하지 않습니다. Service에 gateway를 포함해야 표시됩니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 46,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (environment, service, routeId, httpMethod, httpStatusCode) (rate(spring_cloud_gateway_requests_seconds_sum{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\",service=\"gateway\"}[$__rate_interval])) / (sum by (environment, service, routeId, httpMethod, httpStatusCode) (rate(spring_cloud_gateway_requests_seconds_count{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\",service=\"gateway\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{routeId}} {{httpMethod}} {{httpStatusCode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 106,
      "type": "row",
      "title": "비동기 처리",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "title": "Kafka 소비 지연 (건)",
      "description": "소비자가 발행하는 records_lag_max의 토픽별 최대값입니다. NaN·미측정을 0으로 채우지 않습니다. 브로커의 전체 소비 그룹 적체나 업무 완료 지연을 보장하는 값이 아닙니다. Service 선택이 적용되며 API·HTTP 상태 필터는 적용되지 않습니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (environment, service, topic) (kafka_consumer_fetch_manager_records_lag_max{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\"})",
          "legendFormat": "{{service}} / {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "title": "서비스 처리 지연 현황",
      "description": "선택 서비스의 현재 건수입니다. 30분 초과는 생성 후 30분 넘게 확정되지 않은 처리, 관리자 확인 대기는 자동 처리가 멈춰 담당자 판단을 기다리는 상태입니다. 0건과 데이터 없음을 구분합니다. 기존 스케줄러가 갱신하는 수치이며 전체 업무 완료 시간을 측정하지 않습니다.",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 54,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (environment, service, flow, state) (label_replace(label_replace(transfer_processing_stuck{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\"}, \"flow\", \"송금\", \"__name__\", \".*\"), \"state\", \"30분 초과\", \"__name__\", \".*\") or label_replace(label_replace(transfer_manual_review{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\"}, \"flow\", \"송금\", \"__name__\", \".*\"), \"state\", \"관리자 확인 대기\", \"__name__\", \".*\") or label_replace(label_replace(exchange_order_processing_stuck{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\"}, \"flow\", \"환전\", \"__name__\", \".*\"), \"state\", \"30분 초과\", \"__name__\", \".*\") or label_replace(label_replace(exchange_order_manual_review{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\"}, \"flow\", \"환전\", \"__name__\", \".*\"), \"state\", \"관리자 확인 대기\", \"__name__\", \".*\") or label_replace(label_replace(label_replace(label_replace(label_replace(payment_settlement_stuck{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\"}, \"flow\", \"$1\", \"type\", \"(.+)\"), \"flow\", \"결제\", \"flow\", \"payment\"), \"flow\", \"환불\", \"flow\", \"refund\"), \"flow\", \"정산\", \"flow\", \"settlement\"), \"state\", \"30분 초과\", \"__name__\", \".*\") or label_replace(label_replace(label_replace(label_replace(label_replace(payment_settlement_manual_review{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\"}, \"flow\", \"$1\", \"type\", \"(.+)\"), \"flow\", \"결제\", \"flow\", \"payment\"), \"flow\", \"환불\", \"flow\", \"refund\"), \"flow\", \"정산\", \"flow\", \"settlement\"), \"state\", \"관리자 확인 대기\", \"__name__\", \".*\"))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "건수",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "environment": true
            },
            "renameByName": {
              "service": "서비스",
              "flow": "업무",
              "state": "구분",
              "Value": "건수"
            },
            "indexByName": {
              "Time": 0,
              "service": 1,
              "flow": 2,
              "state": 3,
              "Value": 4
            }
          }
        }
      ]
    },
