      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (environment, service) (rate(http_server_requests_seconds_count{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\",uri!~\"/actuator(/.*)?\",uri=~\"${api}\",status=~\"${status:regex}\",status=~\"5..\"}[$__rate_interval])) or on(environment, service) (sum by (environment, service) (rate(http_server_requests_seconds_count{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\",uri!~\"/actuator(/.*)?\",uri=~\"${api}\",status=~\"${status:regex}\"}[$__rate_interval])) * 0)) / sum by (environment, service) (rate(http_server_requests_seconds_count{job=\"spring-jvm\",environment=~\"${environment:regex}\",service=~\"${service:regex}\",uri!~\"/actuator(/.*)?\",uri=~\"${api}\",status=~\"${status:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
