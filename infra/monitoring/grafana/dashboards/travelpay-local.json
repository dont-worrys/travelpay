          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "title": "Gateway 목적 서비스별 처리 시간 · 평균",
      "description": "Gateway 기본 라우트 계측값입니다. 인증 단계에서 거절되어 라우트 계측까지 진행하지 않은 요청은 나타나지 않을 수 있습니다. I01 시간과 단순 합산·차감해 구간을 단정하지 않습니다. Service 선택이 적용되며 API·HTTP 상태 필터는 적용되지 않습니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, routeId, httpMethod, httpStatusCode) (rate(spring_cloud_gateway_requests_seconds_sum{job=\"spring-jvm\",service=~\"${service:regex}\",service=\"gateway\"}[$__rate_interval])) / (sum by (service, routeId, httpMethod, httpStatusCode) (rate(spring_cloud_gateway_requests_seconds_count{job=\"spring-jvm\",service=~\"${service:regex}\",service=\"gateway\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{routeId}} {{httpMethod}} {{httpStatusCode}}"
