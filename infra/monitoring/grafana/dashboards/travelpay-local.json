        }
      }
    },
    {
      "id": 18,
      "title": "늦어진 처리 / 관리자 확인 현황",
      "description": "선택 서비스의 현재 건수입니다. 30분 초과는 생성 후 30분 넘게 확정되지 않은 처리, 관리자 확인 대기는 자동 처리가 멈춰 담당자 판단을 기다리는 상태입니다. 0건과 데이터 없음을 구분합니다. 기존 스케줄러가 갱신하는 수치이며 전체 업무 완료 시간을 측정하지 않습니다.",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 52,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service, flow, state) (label_replace(label_replace(transfer_processing_stuck{job=\"spring-jvm\",service=~\"${service:regex}\"}, \"flow\", \"송금\", \"__name__\", \".*\"), \"state\", \"30분 초과\", \"__name__\", \".*\") or label_replace(label_replace(transfer_manual_review{job=\"spring-jvm\",service=~\"${service:regex}\"}, \"flow\", \"송금\", \"__name__\", \".*\"), \"state\", \"관리자 확인 대기\", \"__name__\", \".*\") or label_replace(label_replace(exchange_order_processing_stuck{job=\"spring-jvm\",service=~\"${service:regex}\"}, \"flow\", \"환전\", \"__name__\", \".*\"), \"state\", \"30분 초과\", \"__name__\", \".*\") or label_replace(label_replace(exchange_order_manual_review{job=\"spring-jvm\",service=~\"${service:regex}\"}, \"flow\", \"환전\", \"__name__\", \".*\"), \"state\", \"관리자 확인 대기\", \"__name__\", \".*\") or label_replace(label_replace(label_replace(label_replace(label_replace(payment_settlement_stuck{job=\"spring-jvm\",service=~\"${service:regex}\"}, \"flow\", \"$1\", \"type\", \"(.+)\"), \"flow\", \"결제\", \"flow\", \"payment\"), \"flow\", \"환불\", \"flow\", \"refund\"), \"flow\", \"정산\", \"flow\", \"settlement\"), \"state\", \"30분 초과\", \"__name__\", \".*\") or label_replace(label_replace(label_replace(label_replace(label_replace(payment_settlement_manual_review{job=\"spring-jvm\",service=~\"${service:regex}\"}, \"flow\", \"$1\", \"type\", \"(.+)\"), \"flow\", \"결제\", \"flow\", \"payment\"), \"flow\", \"환불\", \"flow\", \"refund\"), \"flow\", \"정산\", \"flow\", \"settlement\"), \"state\", \"관리자 확인 대기\", \"__name__\", \".*\"))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "집계 없음"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "건수",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service": "서비스",
              "flow": "업무",
              "state": "구분",
              "Value": "건수"
            },
            "indexByName": {
              "Time": 0,
              "service": 1,
              "flow": 2,
              "state": 3,
              "Value": 4
            }
          }
        }
      ]
    },
