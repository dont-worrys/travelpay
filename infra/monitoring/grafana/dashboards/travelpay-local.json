        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "title": "Gateway → User 인증 확인 시간 · 평균",
      "description": "현재 Gateway의 전용 WebClient가 User I01 세션 확인을 기다린 평균 시간입니다. Gateway가 선택되어야 표시됩니다. 호출 표본이 없으면 비어 있습니다. Service 선택이 적용되며 API·HTTP 상태 필터는 적용되지 않습니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_client_requests_seconds_sum{job=\"spring-jvm\",service=~\"${service:regex}\",service=\"gateway\",client_name=\"user-service\"}[$__rate_interval])) / (sum by (service) (rate(http_client_requests_seconds_count{job=\"spring-jvm\",service=~\"${service:regex}\",service=\"gateway\",client_name=\"user-service\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{service}} → User I01"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
